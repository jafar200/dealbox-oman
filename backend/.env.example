# DealBox Backend — انسخ هذا الملف إلى `.env` وعبّئ القيم (لا ترفعه أبداً إلى git)
# cp .env.example .env

# المنفذ (خدمات الاستضافة تضبطه تلقائياً عبر PORT)
PORT=5001
NODE_ENV=development

# قاعدة البيانات — محلياً يُستخدم mongodb-memory-server تلقائياً،
# وفي الاستضافة ضع رابط MongoDB Atlas (M0 مجاني):
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dealbox_oman
MONGO_URI=mongodb://localhost:27017/dealbox_oman

# مفتاح الجلسات — إلزامي في الإنتاج (Render يولّده تلقائياً عبر render.yaml)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# رابط الواجهة (يُستخدم في روابط استعادة كلمة المرور)
FRONTEND_URL=http://localhost:3000

# Google Sign-In (مطلوب لدخول التطبيق عبر Google)
# قيمة Web application OAuth Client ID — يجب أن تطابق google_web_client_id في
# mobile/android/app/src/main/res/values/strings.xml و VITE_GOOGLE_CLIENT_ID في الواجهة.
# بدونها يرد الخادم 503 «تسجيل Google غير مهيأ على الخادم» لكل محاولة دخول.
GOOGLE_CLIENT_ID=

# التخزين الخارجي الدائم للصور — Cloudinary (خطة مجانية، بدون بطاقة بنكية)
# أنشئ حساباً مجانياً في cloudinary.com وانسخ القيم من لوحة التحكم (Dashboard)
# عند ضبطها يُرفع كل شعار/صورة إلى CDN دائم، وبدونها يبقى الرفع محلياً (للتطوير)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# البريد (اختياري — يعمل النظام بدونه في وضع التطوير)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=DealBox عُمان <no-reply@dealbox.om>

# Web Push (VAPID) — إشعارات المتصفح/الهاتف عند نشر التنبيه العام.
# ولّد المفاتيح مرة واحدة: npx web-push generate-vapid-keys --json
# ثم ضع القيم في backend/.env وعند الاستضافة في متغيّرات بيئة Render.
# بدونها تعمل بقية الميزات بشكل عادي وتُتخطّى الإشعارات بهدوء.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@dealbox.om
