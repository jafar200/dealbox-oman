# Optional: required only when registering an administrator account
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-registration-code

# MongoDB connection used by the backend
MONGO_URI=mongodb://localhost:27017/dealbox_oman

# Set a unique random secret (at least 32 characters) for production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Mapbox public token for the stores map (frontend).
# Get one free at mapbox.com → put the real value in `.env` (never committed)
# and as VITE_MAPBOX_TOKEN in Vercel environment variables for production.
VITE_MAPBOX_TOKEN=