<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- اسم التطبيق الظاهر تحت الأيقونة -->
    <string name="app_name">DealBox عُمان</string>

    <!--
      ═══════════════════════════════════════════════════════════
      رابط الموقع المحمّل في التطبيق — عدّله قبل البناء:
        • تجربة محلية على محاكي Android Studio:
          http://10.0.2.2:3000/?portal=client
        • تجربة محلية على جهاز حقيقي (نفس شبكة الواي فاي):
          http://192.168.x.x:3000/?portal=client   (IP جهازك)
        • إنتاج (بعد نشر الموقع على دومين حقيقي):
          https://dealbox.om/?portal=client
      ═══════════════════════════════════════════════════════════
      افتتاحية التطبيق: يبدأ بصفحة المقدمة (intro) ثم ينتقل تلقائياً
      لصفحة الزبون (client) عند الضغط على «ابدأ الآن» أو «تخطي».
    -->
    <string name="webapp_url">https://dealbox-oman.vercel.app/?portal=intro</string>

    <!--
      معرّف عميل Google (Web application OAuth Client ID) — لتسجيل الدخول الأصلي.
      الصقه هنا من Google Cloud Console (ينتهي بـ .apps.googleusercontent.com).
      يُستخدم كاحتياطي إذا لم تُمرّر الواجهة قيمة، ويجب أن يطابق:
        • GOOGLE_CLIENT_ID في خادم Render (للتحقق من الرمز)
        • Google Client ID في لوحة الآدمن / VITE_GOOGLE_CLIENT_ID على Vercel
      ملاحظة: يجب أيضاً إنشاء عميل OAuth من نوع Android بنفس اسم الحزمة
      om.dealbox.app وبصمة SHA-1 لمفتاح التوقيع (انظر mobile/README.md).
    -->
    <string name="google_web_client_id" translatable="false">PUT_WEB_CLIENT_ID.apps.googleusercontent.com</string>

    <string name="webapp_offline">لا يوجد اتصال بالإنترنت.\nتحقق من الشبكة ثم حاول مجدداً.</string>
</resources>
