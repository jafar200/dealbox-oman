# Dependencies
node_modules/
backend/node_modules/

# Build output
dist/

# Environment files (never commit secrets)
.env
.env.local
backend/.env

# Uploaded images (ephemeral on free hosting — not part of the repo)
backend/uploads/
!backend/uploads/.gitkeep

# Local dev database (regenerated automatically — never commit)
backend/data/

# Logs & debug
*.log
.manus-logs/
npm-debug.log*

# OS & editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Android build artifacts & local config (generated by Android Studio / Gradle)
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/gradle/
*.apk
*.aab

# Signing keys — never commit (secrets)
*.keystore
*.jks

# Temp
*.tmp
